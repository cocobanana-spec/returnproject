// 랜딩·처리방침 — Cloudflare Workers 정적 자산으로 ppurin.com 에 올린다
//
// wrangler 4.147 부터 `pages project create` 가 Workers 로 보내진다(Pages 가 Workers 에 흡수됨).
// 그래서 Pages 명령 대신 `wrangler deploy -c 이 파일` 을 쓴다. 자산 폴더와 커스텀 도메인을 여기서
// 선언하면 DNS 레코드까지 같은 계정 안에서 자동으로 생긴다(도메인을 Cloudflare 에서 샀기 때문).
//
// 나중에 청첩장 공개 페이지(/i/{코드})가 생기면 `main` 에 워커 스크립트를 두고
// `run_worker_first: ["/i/*"]` 로 그 경로만 서버가 받게 한다(docs/08 §3.3).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppurin-site",
  "compatibility_date": "2026-10-01",
  "account_id": "bfa3b35cbbfa042aaabffd880f3eb75d",
  "assets": {
    "directory": "./site",
    // 없는 경로는 404.html 이 아니라 404 로. 랜딩은 단일 페이지 앱이 아니다.
    "not_found_handling": "404-page",
    // /privacy 와 /privacy.html 둘 다 열린다(.html 생략 허용)
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "ppurin.com", "custom_domain": true },
    { "pattern": "www.ppurin.com", "custom_domain": true }
  ]
}
