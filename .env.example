# Supabase 연결 값. 실제 값은 .env.local 에 두고 저장소에 커밋하지 않는다.
# 값을 받는 법: supabase projects api-keys --project-ref <프로젝트 ref> --output json
# 또는 Supabase 대시보드 → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://<프로젝트-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon 키>

# 개발 전용 메일 로그인 진입점 (선택)
# 소셜 로그인 콘솔이 준비되기 전까지 시뮬레이터에서 화면을 확인하기 위한 것이다.
# __DEV__ 이고 EXPO_PUBLIC_DEV_SIGNIN=1 일 때만 버튼이 보인다. 릴리스 번들에는 나타나지 않는다.
EXPO_PUBLIC_DEV_SIGNIN=0
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=
